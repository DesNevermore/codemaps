experiments/**/solution/binary_copy
experiments/**/solution/**/binary_copy
**/solution_snapshot/executable

# Runtime monitoring logs (regenerated; not source)
guard/*.log*

# ── this session: baseline runs (keep prompts/scripts/README/trajectory + final source; drop heavy run state) ──
# CC baseline live workspace (the candidate being edited in-container; source is archived in final_candidate/)
baselines/claude-code/experiments/*/workspace/
