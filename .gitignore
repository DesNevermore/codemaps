baselines/mini-swe-agent/**/COST_STATS.json
baselines/mini-swe-agent/**/DEFERRED_*.txt
baselines/mini-swe-agent/**/driver.log
baselines/mini-swe-agent/**/ALL_DONE
baselines/mini-swe-agent/**/ALL_REGRADED

