.claude/

# scaffold-evolution run artifacts + logs (experiment output, not source)
scaffold/runs/
scaffold/results/

# findings registries: the per-task *.json are run-regenerable DATA products (a single age.json
# hit 9.6 MB / 8153 cases), so they don't belong in git history. Keep the human-authored *.md
# (INDEX.md + CASE_*.md case studies) which ARE knowledge worth versioning.
findings/divergences/*.json
findings/flaky_oracles/*.json
findings/undocumented/*.json

baselines/claude-code/2026-7-4/

