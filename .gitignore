baselines/claude-code/experiments/*/workspace_v1_backup/
baselines/**/logs/
baselines/**/*.log
# raw claude session transcript can be huge; keep openhands.traj.json, drop the raw jsonl
baselines/**/trajectory/session_*.jsonl
# stray model-id probe markers
baselines/**/model_deepseek*

# cc-vs-harness comparison: keep COMPARISON.md + driver-made seeds, drop the live harness run dir
experiments/cc-vs-harness-hexyl/phase2/
experiments/cc-vs-harness-hexyl/msa_seeded_run/cand/
